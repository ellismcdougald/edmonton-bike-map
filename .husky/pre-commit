#!/bin/sh
set -e

# -- Frontend --
cd frontend || exit 1

echo "Auto-fixing frontend formatting..."
prettier --write "**/*.{js,ts,tsx,css,scss,html,vue,json,md}" --log-level silent

echo "Running ESLint..."
eslint . --ext .js,.ts,.tsx
ESLINT_EXIT_CODE=$?

cd ..

# -- Backend -- 
cd backend || exit 1

echo "Auto-fixing gofmt formatting..."
gofmt -l -w .

echo "Running golangci-lint..."
golangci-lint run ./...
LINTER_EXIT_CODE=$?

cd ..

# Fail commit if ESLint or golangci-lint failed
if [ $ESLINT_EXIT_CODE -ne 0 ] || [ $LINTER_EXIT_CODE -ne 0 ]; then
  echo "Commit failed: Lint errors detected."
  exit 1
fi

echo "Formatting auto-fixed. Commit can proceed."
