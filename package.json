{
  "name": "edmonton-bike-map",
  "version": "1.0.0",
  "description": "Finding a safe and comfortable bike route from one place to another isn't as simple as plugging in start and end addresses into Google Maps. I often find myself piecing together a route using a combination of a map of Edmonton's bike infastructure and Google Maps streetview to verify the suitability of different routes. Some roads are simply unsafe for bikes, while others may be uncomfortable. Even where bike infastructure is available, an adjacent quiet residential street might be more comfortable to ride on.",
  "main": "commitlint.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "dev:build": "docker compose --env-file .env -f docker-compose.yml -p bike-map-dev build --no-cache",
    "dev:start": "docker compose --env-file .env -f docker-compose.yml -p bike-map-dev up -d",
    "dev:stop": "docker compose -p bike-map-dev down",
    "dev:restart": "npm run dev:stop && npm run dev:build && npm run dev:start",
    "dev:fl": "docker compose -p bike-map-dev logs dev-frontend",
    "dev:bl": "docker compose -p bike-map-dev logs dev-backend",
    "dev:fr": "docker compose -p bike-map-dev restart dev-frontend",
    "dev:br": "docker compose -p bike-map-dev restart dev-backend",
    "test:build": "docker compose --env-file .env.test -f docker-compose.test.yml -p bike-map-test build --no-cache",
    "test:start": "docker compose --env-file .env.test -f docker-compose.test.yml -p bike-map-test up --force-recreate -d",
    "test:stop": "docker compose -p bike-map-test down",
    "test:fl": "docker compose -p bike-map-test logs test-frontend",
    "test:bl": "docker compose -p bike-map-test logs test-backend",
    "test:fr": "docker compose -p bike-map-test restart test-frontend",
    "test:br": "docker compose -p bike-map-test restart test-backend",
    "test:restart": "npm run test:stop && npm run test:build && npm run test:start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellismcdougald/edmonton-bike-map.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ellismcdougald/edmonton-bike-map/issues"
  },
  "homepage": "https://github.com/ellismcdougald/edmonton-bike-map#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.56.1",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  }
}
