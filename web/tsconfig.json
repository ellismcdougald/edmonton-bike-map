{
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "rootDir": "ts",
    "outDir": "js",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["ts/**/*"]
}
